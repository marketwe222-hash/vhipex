// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" | 
}

// ─── Auth ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Student ─────────────────────────────────────────────────────────────────

model Student {
  id          String   @id @default(cuid())
  userId      String   @unique
  studentId   String   @unique   // e.g. "VHX-2024-001"
  firstName   String
  lastName    String
  dateOfBirth DateTime
  gender      String
  phone       String?
  address     String?
  class       String             // e.g. "Form 5A"
  department  String?
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results Result[]
}

// ─── Results ─────────────────────────────────────────────────────────────────

model Result {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  score     Float
  grade     String
  term      String   // e.g. "Term 1"
  year      String   // e.g. "2024/2025"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([year, term])
}

// ─── News ────────────────────────────────────────────────────────────────────

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model News {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String     @db.Text
  coverImage  String?
  category    String?
  tags        String[]
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([status])
}

// ─── Gallery ─────────────────────────────────────────────────────────────────

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String?
  createdAt DateTime @default(now())
}

// ─── Contact ─────────────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}